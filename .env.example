# Public site URL used for canonical/OG metadata. No secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until launch approval (NFR-11: staging must not be indexed).
NEXT_PUBLIC_SITE_INDEXABLE=false

# Firebase server configuration. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
# Set these two from a Firebase service account, OR use GOOGLE_APPLICATION_CREDENTIALS
# pointing to a JSON key OUTSIDE the repository. Managed Google hosts can use ADC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side Firebase Email/Password sign-in for admin-created user accounts.
# Enable the Email/Password provider in Firebase Authentication. This is the project's
# Web API key (Firebase project settings); it is never sent to this app's browser.
FIREBASE_WEB_API_KEY=

# Admin at /admin: one shared password. Use a long passphrase in production.
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Allowed browser origin for sign-in, sign-out and other writes (scheme + host + port).
# Production: https://www.nourawellbeing.com (the apex redirects to www).
# For multiple serving domains, list exact origins separated by commas; no wildcards.
# Whitespace and trailing slashes are normalized. When unset, NEXT_PUBLIC_SITE_URL
# is used. Production never trusts request Host/forwarded headers as configuration.
# Set production values in the hosting dashboard; .env.local is not deployed by Git.
NOURA_APP_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
NOURA_RATE_LIMIT_SECRET=
# Optional: only a header your hosting ingress ALWAYS overwrites. Blank = shared limit.
NOURA_TRUSTED_IP_HEADER=

# Owner requested collection remain disabled pending approval.
NOURA_REQUESTS_ENABLED=false
NOURA_FORM_FIELDS_APPROVED=false
NOURA_PRIVACY_NOTICE_VERSION=
NOURA_OPERATING_TIMEZONE=
