# Public site URL used for canonical/OG metadata. No secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until launch approval (NFR-11: staging must not be indexed).
NEXT_PUBLIC_SITE_INDEXABLE=false

# Firebase server configuration. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
# Set these two from a Firebase service account, OR use GOOGLE_APPLICATION_CREDENTIALS
# pointing to a JSON key OUTSIDE the repository. Managed Google hosts can use ADC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin at /admin: one shared password. Use a long passphrase in production.
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Exact website origin (scheme + hostname + optional port, no trailing slash).
NOURA_APP_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
NOURA_RATE_LIMIT_SECRET=
# Optional: only a header your hosting ingress ALWAYS overwrites. Blank = shared limit.
NOURA_TRUSTED_IP_HEADER=

# Owner requested collection remain disabled pending approval.
NOURA_REQUESTS_ENABLED=false
NOURA_FORM_FIELDS_APPROVED=false
NOURA_PRIVACY_NOTICE_VERSION=
NOURA_OPERATING_TIMEZONE=
